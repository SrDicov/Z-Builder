#!/bin/sh

# Remove unconfigured sessions
rm -f /usr/share/{wayland-,x}sessions/{openbox,kodi*}.desktop 2>/dev/null
# and wayland in live
#[ $(hostname) == artix-live ] && rm -f /usr/share/wayland-sessions/* 2>/dev/null

# plasma sessions get pulled in by calamares for all variants
. /etc/os-release
case "$VARIANT" in
    *cinnamon*|*lxde*|*mate*|*xfce*|*community-gtk*)
        rm -f /usr/share/{wayland-,x}sessions/{plasma*,*wayland}.desktop 2>/dev/null
        ;;
    *gaming*)
        username=$(awk -F: '$3 == 1000 { print $1; exit }' /etc/passwd)
        [ -n "$username" ] && usermod -a -G games $username
        ;;
fi

        ;;
    *)
        true
        ;;
esac

# Run once and disappear
rm -f $0
